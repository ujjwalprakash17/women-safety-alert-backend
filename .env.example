# Supabase Postgres connection string — Project Settings > Database > Connection string.
# Prefer the SESSION POOLER string (port 5432, host aws-0-<region>.pooler.supabase.com,
# user postgres.<PROJECT_REF>) over the "direct" db.<PROJECT_REF>.supabase.co host: the
# direct host is IPv6-only and may be unreachable on IPv4-only networks. Avoid the
# TRANSACTION pooler (port 6543) — DDL from Alembic migrations can misbehave through it.
# URL-encode any special characters (%, @, etc.) in the password with urllib.parse.quote.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project Settings > API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated

# Only needed if this project still signs JWTs with the legacy HS256 shared secret
# (Project Settings > API > JWT Settings tells you which mode is active).
# SUPABASE_JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000

# Web Push (VAPID) — generate with `python -m py_vapid --gen` from backend/,
# then derive VAPID_PUBLIC_KEY (base64url uncompressed EC point) from the
# generated public_key.pem. Leave VAPID_PRIVATE_KEY unset to disable push
# sending entirely (the app still boots fine either way).
VAPID_PRIVATE_KEY=private_key.pem
VAPID_PUBLIC_KEY=<base64url-public-key>
VAPID_CONTACT_EMAIL=mailto:admin@example.com
