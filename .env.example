# Supabase Postgres connection string — Project Settings > Database > Connection string.
# Use the DIRECT connection (port 5432), not the pgbouncer transaction pooler (6543):
# DDL from Alembic migrations can misbehave through the pooler.
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Project Settings > API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated

# Only needed if this project still signs JWTs with the legacy HS256 shared secret
# (Project Settings > API > JWT Settings tells you which mode is active).
# SUPABASE_JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000
